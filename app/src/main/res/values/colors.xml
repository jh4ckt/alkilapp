<resources>

    <!-- ============================================================= -->
    <!-- Design tokens (semanticos)                                    -->
    <!-- Regla 60-30-10:                                              -->
    <!--   60% superficie neutra  -> bg_main + surface_card            -->
    <!--   30% estructura/lectura -> brand_primary + text_muted        -->
    <!--   10% accion prioritaria -> brand_accent                      -->
    <!-- ============================================================= -->

    <!-- brand-accent: CTAs, estados activos, favoritos, pines del mapa -->
    <color name="brand_accent">#FF6B5E</color>
    <color name="brand_accent_dark">#E85548</color>
    <color name="brand_accent_soft">#FFE4E1</color>

    <!-- brand-primary: encabezados, navbar, titulos, iconos activos -->
    <color name="brand_primary">#1E293B</color>
    <color name="brand_primary_dark">#0F172A</color>
    <color name="brand_primary_light">#E2E8F0</color>
    <color name="brand_primary_soft">#F1F5F9</color>

    <!-- background / card -->
    <color name="bg_main">#F8FAFC</color>
    <color name="surface_card">#FFFFFF</color>

    <!-- border-subtle: bordes de cards e inputs -->
    <color name="border_subtle">#E2E8F0</color>

    <!-- text-muted: metraje, habitaciones, ubicacion, labels -->
    <color name="text_muted">#64748B</color>

    <!-- text-hint: placeholders de inputs (legibles sobre blanco) -->
    <color name="text_hint">#64748B</color>

    <!-- on-dark-soft: texto secundario sobre fondo brand_primary -->
    <color name="on_dark_soft">#CBD5E1</color>

    <!-- Variantes para TEXTO: los tonos de marca no alcanzan 4.5:1 sobre blanco -->
    <color name="gold_text">#8A6A00</color>
    <color name="success_text">#1F7A57</color>
    <color name="coral_text">#C0392B</color>

    <!-- Coral profundo: fondo de botones/CTA con TEXTO BLANCO (#FF6B5E daba 2.7:1) -->
    <color name="brand_accent_deep">#D24534</color>

    <!-- status-success: "Disponible", anfitrion verificado -->
    <color name="status_success">#3AA37B</color>
    <color name="status_success_dark">#237A58</color>
    <color name="status_success_soft">#E4F3EC</color>

    <!-- brand-gold: publicaciones destacadas / premium -->
    <color name="brand_gold">#D4A017</color>
