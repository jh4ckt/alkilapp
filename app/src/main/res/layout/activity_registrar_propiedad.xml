<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_soft"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/btnRegistrarBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_atras"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/tvRegistrarTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/prop_agregar_titulo"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPublicarPaso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/prop_paso_inicial"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPublicarTituloPaso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prop_paso_fotos"
                android:textColor="@color/alkil_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressPublicar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="8dp"
            android:max="5"
            android:progress="1"
            android:progressBackgroundTint="@color/alkil_primary_light"
            android:progressTint="@color/brand_accent_deep" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollPublicarForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="2dp"
                android:paddingBottom="12dp"
                android:text="@string/prop_form_intro"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/contenedorPasosPublicar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/pagePublicarFotos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/divider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/prop_seccion_fotos"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/prop_seccion_fotos_ayuda"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPropAgregarFoto"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="12dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/prop_fotos_agregar"
                                android:textAllCaps="false"
                                android:textColor="@color/coral_text"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_add"
                                app:iconGravity="textStart"
                                app:iconTint="@color/coral_text"
                                app:strokeColor="@color/alkil_coral_dark" />

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:scrollbars="none">

                                <LinearLayout
                                    android:id="@+id/llPropFotos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingTop="2dp" />
                            </HorizontalScrollView>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pagePublicarDatos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/divider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/prop_seccion_datos"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:hint="@string/prop_hint_titulo">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPropTitulo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="textCapSentences"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/prop_tipo_label"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="12sp" />
                                    <Spinner
                                        android:id="@+id/spPropTipo"
                                        android:layout_width="match_parent"
                                        android:layout_height="48dp"
                                        android:background="@drawable/bg_spinner_rounded"
                                        android:popupBackground="@drawable/bg_spinner_popup"
                                        android:spinnerMode="dropdown" />
                                </LinearLayout>

                                <View android:layout_width="10dp" android:layout_height="1dp" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/prop_operacion_label"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="12sp" />
                                    <Spinner
                                        android:id="@+id/spPropOperacion"
                                        android:layout_width="match_parent"
                                        android:layout_height="48dp"
                                        android:background="@drawable/bg_spinner_rounded"
                                        android:popupBackground="@drawable/bg_spinner_popup"
                                        android:spinnerMode="dropdown" />
                                </LinearLayout>
                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="@string/prop_hint_precio">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPropPrecio"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="numberDecimal"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/prop_moneda_label"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                            <Spinner
                                android:id="@+id/spPropMoneda"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_spinner_rounded"
                                android:popupBackground="@drawable/bg_spinner_popup"
                                android:spinnerMode="dropdown" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pagePublicarUbicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/divider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/prop_seccion_ubicacion"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/prop_buscar_dir_label"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:hint="@string/prop_buscar_dir_hint">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPropBuscarDir"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="textCapSentences"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <TextView
                                android:id="@+id/tvPropBuscarEspera"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/prop_buscar_dir_espera"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="italic" />
                            <LinearLayout
                                android:id="@+id/llSugerencias"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone" />
                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="@string/prop_hint_direccion">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPropDireccion"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="textCapSentences"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPropElegirMapa"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/prop_elegir_mapa"
                                android:textAllCaps="false"
                                android:textColor="@color/alkil_primary"
                                android:textSize="13sp"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_location"
                                app:iconGravity="textStart"
                                app:iconTint="@color/brand_accent_deep"
                                app:strokeColor="@color/divider" />
                            <TextView
                                android:id="@+id/tvPropUbicacionInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/prop_ubicacion_info"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/prop_departamento_label"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="12sp" />
                                    <Spinner
                                        android:id="@+id/spPropDepartamento"
                                        android:layout_width="match_parent"
                                        android:layout_height="48dp"
                                        android:background="@drawable/bg_spinner_rounded"
                                        android:popupBackground="@drawable/bg_spinner_popup"
                                        android:spinnerMode="dropdown" />
                                </LinearLayout>
                                <View android:layout_width="10dp" android:layout_height="1dp" />
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/prop_distrito_label"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="12sp" />
                                    <Spinner
                                        android:id="@+id/spPropDistrito"
                                        android:layout_width="match_parent"
                                        android:layout_height="48dp"
                                        android:background="@drawable/bg_spinner_rounded"
                                        android:popupBackground="@drawable/bg_spinner_popup"
                                        android:spinnerMode="dropdown" />
                                </LinearLayout>
                            </LinearLayout>
                            <TextView
                                android:id="@+id/tvPropZonaAuto"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:drawablePadding="6dp"
                                android:gravity="center_vertical"
                                android:text="@string/prop_zona_autocompletada"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pagePublicarCaracteristicas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/divider"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/prop_seccion_caracteristicas"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/prop_hint_ambientes">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etPropAmbientes"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:importantForAutofill="no"
                                        android:inputType="number"
                                        android:maxLines="1" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <View android:layout_width="10dp" android:layout_height="1dp" />
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/prop_hint_superficie">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etPropSuperficie"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:importantForAutofill="no"
                                        android:inputType="numberDecimal"
                                        android:maxLines="1" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="@string/prop_comodidades_label"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/cgPropComodidades"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pagePublicarDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/divider"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/prop_seccion_descripcion"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:hint="@string/prop_hint_descripcion">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPropDescripcion"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="top"
                                    android:importantForAutofill="no"
                                    android:inputType="textCapSentences|textMultiLine"
                                    android:minLines="4" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublicarAnterior"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/prop_paso_anterior"
                android:textAllCaps="false"
                android:visibility="gone"
                app:cornerRadius="13dp"
                app:icon="@drawable/ic_back"
                app:iconGravity="textStart"
                app:strokeColor="@color/divider" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublicarSiguiente"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/brand_accent_deep"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/prop_paso_siguiente"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="13dp"
                app:icon="@drawable/ic_chevron"
                app:iconGravity="textEnd"
                app:iconTint="@color/white" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarGuardar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="@color/brand_accent_deep"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/prop_guardar"
