<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- 1. Mapa de Google a pantalla completa -->
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Badges estáticos de disponibilidad por zona (sobre el mapa) -->
    <FrameLayout
        android:id="@+id/overlayBadges"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- 3. Stack superior: fila de busqueda + chips de tipo + contador.
         El margen superior (8dp + inset de barra de estado) lo aplica el codigo. -->
    <LinearLayout
        android:id="@+id/stackTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

    <!-- Stack superior (Compose): fila de menu + busqueda/filtro + boton
         publicar, chips rapidos de tipo y pill de contador. El margen superior
         (8dp + inset de barra de estado) lo aplica el codigo sobre stackTop. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvStackTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false" />

    </LinearLayout>

    <!-- 6. Bottom Sheet colapsable/expandible con listado de inmuebles.
         Implementacion manual (SIN BottomSheetBehavior): altura fija = 60% de la
         pantalla y se minimiza desplazando el sheet hacia abajo con translationY,
         dejando visible solo el peek (handle + titulo). -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        android:orientation="vertical">

        <!-- Zona de arrastre: handle + titulo -->
        <LinearLayout
            android:id="@+id/sheetHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:background="@android:color/white"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/sheetHandle"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/sheet_handle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nearby_title"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="16dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nearby_subtitle"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Listado de inmuebles en Compose (LazyColumn + estado vacio) -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/cvLista"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/white" />

        </FrameLayout>

    </LinearLayout>

    <!-- 7. Botón "mi ubicación" (se posiciona justo sobre el bottomSheet y sube con él vía código) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMiUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="108dp"
        android:contentDescription="@string/mi_ubicacion_btn"
        android:src="@android:drawable/ic_menu_mylocation" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- 8. Menu lateral (hamburguesa): cabecera de sesion + accesos -->
    <include
        android:id="@+id/panelMenu"
        layout="@layout/panel_menu"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>