<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Mapa de Google a pantalla completa -->
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Badges estáticos de disponibilidad por zona (sobre el mapa) -->
    <FrameLayout
        android:id="@+id/overlayBadges"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- 3. Fila superior: menú (hamburguesa) + barra de búsqueda/filtro, alineados -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_sidebar"
            android:contentDescription="@string/menu_principal_cd"
            android:importantForAutofill="no"
            android:padding="11dp"
            android:src="@drawable/ic_hamburger"
            app:tint="@color/alkil_primary" />

        <!-- 4. Barra de búsqueda y filtro (junto al menú) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBusqueda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search" />

            <EditText
                android:id="@+id/etBusqueda"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:inputType="text"
                android:paddingStart="12dp"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnFiltroBuscar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/filtros_titulo"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_filter"
                app:tint="@color/text_secondary" />

        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 5. Botón flotante para publicar (debajo de la búsqueda, sin solaparla) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="148dp"
        android:contentDescription="@string/prop_agregar_titulo"
        android:src="@drawable/ic_add" />

    <!-- 6. Panel inferior deslizable (BottomSheet) -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:background="@android:color/white"
        android:orientation="vertical"
        app:behavior_peekHeight="100dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@color/sheet_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nearby_title"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDepartamentos"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

    <!-- 7. Botón "mi ubicación" (se posiciona justo sobre el bottomSheet y sube con él vía código) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMiUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="108dp"
        android:contentDescription="@string/mi_ubicacion_btn"
        android:src="@android:drawable/ic_menu_mylocation" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>