# Credenciales de la Cloud Function de soporte.
# Copiar a .env y completar (el .env NO se sube a git).
# Se inyectan en el deploy con: gcloud functions deploy ... --set-env-vars "..."

# Destinatario de las notificaciones (por defecto: alkilapp2026@gmail.com)
SOPORTE_DESTINO=alkilapp2026@gmail.com

# --- PROVEEDOR 1 (recomendado): Resend ---
# API key en https://resend.com/api-keys -> Create API Key (plan gratis: 3000 emails/mes).
# El remitente por defecto (onboarding@resend.dev) solo puede enviar al correo con
# el que se registro la cuenta de Resend.
RESEND_API_KEY=
RESEND_FROM=AlkilApp Soporte <onboarding@resend.dev>

# --- PROVEEDOR 2 (fallback): Nodemailer + Gmail ---
# Requiere "contraseña de aplicacion" de Google, que ya no se ofrece en la
# mayoria de cuentas personales. Solo dejar si se consigue una.
GMAIL_USER=alkilapp2026@gmail.com
GMAIL_APP_PASSWORD=
