rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // PROPIEDADES: fichas publicas. Solo autenticados pueden crear;
    // update/delete SOLO el dueno (para "dar por finalizada" la publicacion).
    //
    // EXCEPCION (acuerdo de alquiler aceptado): cuando el dueno publica una
    // propuesta escribe "acuerdoPendiente" con el chat y la propuesta. El otro
    // participante (el arrendatario) puede entonces poner el inmueble en
    // "pausada" para despublicarlo, y SOLO cambiando ese campo, y solo si el
    // chat ya consta como acuerdo aceptado. El dueño siempre puede cambiarlo.
    match /propiedades/{propiedad} {
      function acuerdoAceptado(uid) {
        // OJO: los chats antiguos y las publicaciones sin acuerdo NO tienen estos
        // campos. Leerlos con ".campo" da error de evaluacion (= deny), asi que
        // siempre se leen con .data.get(campo, valorPorDefecto). El id del chat se
        // usa como parametro del path (no como $(...) del match) porque dentro de
        // una funcion el emulador no resuelve bien los wildcards del path.
        let ap = resource.data.get('acuerdoPendiente', {});
        let chatId = ap.get('chatId', '');
        return ap is map
          && chatId is string
          && chatId.size() > 0
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])
          && get(/databases/$(database)/documents/chats/$(chatId)).data.get('acuerdo', {}).get('estado', '') == 'aceptada'
          && get(/databases/$(database)/documents/chats/$(chatId)).data.get('acuerdo', {}).get('propuestaId', '') == ap.get('propuestaId', '');
      }
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.idPropietario
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
                && request.resource.data.estado == 'pausada'
                && acuerdoAceptado(request.auth.uid)));
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.idPropietario;
    }

    // USUARIOS: perfil publico para lectura; cada usuario escribe SIEMPRE su mismo
    // doc (doc id = uid).
    //
    // BLINDAJE (v14): el cliente solo puede escribir los campos de perfil que la app
    // escribe de verdad. Con "hasOnly" queda prohibido de raiz todo lo que escribe el
    // ADMIN con la service account: "estado" (activo/suspendido/desactivado),
    // "trustLevel", "verificationBadge" y "verification.identityVerified" (el escudo
    // de "verificado" que se lee en el perfil del propietario). Antes de este
    // cambio el usuario podia auto-asignarse el escudo verificado y hasta
    // des-suspenderse a si mismo escribiendo estado="activo".
    //
    // EXCEPCION (resenas): un autenticado actualiza SOLO los agregados de
    // calificacion ("rating"/"totalRatings") y solo si tiene una resena real escrita
    // (asi nadie se infla la reputacion sin reseñar).
    match /usuarios/{usuario} {
      // Campos que el cliente legitimamente escribe (ver AuthActivity.guardarUsuarioEnBase,
      // MainActivity.guardarUsuarioEnBase, MiPerfilActivity.guardarPerfil y
      // VerificacionActivity). Todo lo demas es del backend.
      function camposPerfil() {
        return ['nombre', 'email', 'uidAuth', 'activo', 'telefono', 'tipoUsuario',
                'fechaRegistro', 'zonaDepartamento', 'zonaCiudad', 'fotoBase64',
                'verification'];
      }
      // "verification" escrito por el cliente es solo un ENVIO: estado "pendiente" y
      // sin "identityVerified"/"motivo" (los pone el admin al aprobar o rechazar).
      function verificationPermitida() {
        return !('verification' in request.resource.data)
          || (request.resource.data.verification is map
            && !('identityVerified' in request.resource.data.verification)
            && !('motivo' in request.resource.data.verification)
            && request.resource.data.verification.get('status', '') == 'pendiente'
            && request.resource.data.verification.get('documentoPendiente', false) == true
            && request.resource.data.verification
                 .diff(resource.data.get('verification', {}))
                 .affectedKeys()
                 .hasOnly(['status', 'documentoPendiente', 'tipoDocumento',
                           'numeroDocumento', 'enviadoEn']));
      }
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == usuario
        // En create no hay "resource", asi que se listan las claves directas.
        && request.resource.data.keys().hasOnly(camposPerfil())
        && verificationPermitida();
      allow update: if request.auth != null && (
        (request.auth.uid == usuario
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposPerfil())
          && verificationPermitida())
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'totalRatings'])
            && exists(/databases/$(database)/documents/usuarios/$(usuario)/reviews/$(request.auth.uid)))
      );
      allow delete: if request.auth != null && request.auth.uid == usuario;
    }

    // REVIEWS de un usuario: lectura publica; el autor crea SOLO su propia resena
    // (authorId == uid) con rating 1..5; solo el autor actualiza/borra.
    match /usuarios/{usuario}/reviews/{review} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid;
    }

    // CHATS: los participantes leen y actualizan; para CREAR (resource es null)
    // se valida contra request.resource.data. La lectura admite docs AUN INEXISTENTES
    // (!exists) para el patron get-or-create de la ficha.
    match /chats/{chat} {
      allow read: if request.auth != null
        && (request.auth.uid in resource.data.participants
            || !exists(/databases/$(database)/documents/chats/$(chat)));
      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 10
        && request.auth.uid in request.resource.data.participants;
      // Estados validos del chat: "abierto", "cerrado" (manual o automatico a
      // las 48h) y "acuerdo_cerrado" (acuerdo aceptado, sigue escribible 48h).
      // No se puede inventar otro estado ni saltarse la lista cerrada.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        // La lista de participantes es inmutable: nadie se cuela ni expulsa a otro.
        && request.resource.data.participants == resource.data.participants
        // BLINDAJE (v14): el inmueble asociado tampoco se puede re-apuntar. Sin esto
        // un participante podria poner "listingId" de una publicacion suya y pasar
        // por dueno dentro de este chat.
        && (!('listingId' in request.resource.data)
            || ('listingId' in resource.data
                && request.resource.data.listingId == resource.data.listingId))
        // "acuerdo" es el espejo del cierre de una propuesta y SOLO lo escribe la
        // service account (backend). Antes era escribible por cualquier
        // participante, y como "propiedades" permite pausarse cuando el chat consta
        // con acuerdo aceptado, un arrendatario podia despublicar el inmueble de otro
        // escribiendo acuerdo={estado:"aceptada"}. La verdad es el mensaje de tipo
        // "propuesta" y su "propuestaEstado" (ya protegido mas abajo).
        && (!('acuerdo' in request.resource.data)
            || request.resource.data.acuerdo == resource.data.get('acuerdo', {}))
        && (!('estado' in request.resource.data)
            || request.resource.data.estado in ['abierto', 'cerrado', 'acuerdo_cerrado'])
        // "deletedForUsers" (ocultar chat, NO borrar) solo puede CRECER con el propio
        // uid del usuario: nadie quita UIDs ni oculta el chat de otro.
        && (!('deletedForUsers' in request.resource.data)
            || request.resource.data.deletedForUsers == resource.data.get('deletedForUsers', [])
            || (request.resource.data.deletedForUsers.size()
                  == resource.data.get('deletedForUsers', []).size() + 1
                && request.resource.data.deletedForUsers.hasAll(resource.data.get('deletedForUsers', []))
                && request.auth.uid in request.resource.data.deletedForUsers
                && !(request.auth.uid in resource.data.get('deletedForUsers', []))));
      // NO se permite delete desde el cliente: los chats se ocultan con
      // "deletedForUsers" para conservar el historial completo (auditoria/soporte).
      allow delete: if false;
    }

    // MENSAJES: solo participantes del chat pueden leer; al crear el mensaje debe
    // pertenecer al autor ("senderId") y tener texto 1..1000 chars. Si el inmueble
    // asociado fue finalizado/alquilado, el chat queda cerrado (no se crean mas mensajes).
    //
    // Tipos de mensaje (campo "tipo"): "texto" (normal), "propuesta" (tarjeta de
    // acuerdo), "cita" (visita agendada) y "sistema" (avisos como "el chat ha
    // sido cerrado"). Los chats antiguos no tienen "tipo": se tratan como "texto".
    match /chats/{chat}/messages/{message} {
      // OJO (get() + wildcards): dentro de una funcion, get() solo resuelve bien
      // si el id del documento se recibe como PARAMETRO. Si el helper usa el
      // wildcard del match ($(chat)) directamente, get() devuelve null y la regla
      // entera acaba en error de evaluacion (= deny). Por eso estos helpers
      // reciben chatId como argumento y no usan $(chat) por su cuenta.
      //
      // Ademas, chats y publicaciones antiguos pueden no tener "listingId",
      // "estado" o "acuerdoPendiente": todo se lee con .data.get(campo, defecto)
      // para que un documento legacy no bloquee la conversacion.
      function chatParticipa(chatId, uid) {
        return get(/databases/$(database)/documents/chats/$(chatId)).data is map
          && uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []);
      }
      // listingId del inmueble del chat, o "" si el chat no existe o no lo tiene.
      function chatListingId(chatId) {
        return get(/databases/$(database)/documents/chats/$(chatId)).data is map
          && get(/databases/$(database)/documents/chats/$(chatId)).data.get('listingId', '') is string
          ? get(/databases/$(database)/documents/chats/$(chatId)).data.get('listingId', '')
          : '';
      }
      // El chat esta cerrado (a mano o automaticamente a las 48h del acuerdo).
      // Los chats antiguos no tienen "estado": se consideran "abierto".
      function chatCerrado(chatId) {
        return get(/databases/$(database)/documents/chats/$(chatId)).data is map
          && get(/databases/$(database)/documents/chats/$(chatId)).data.get('estado', 'abierto') == 'cerrado';
      }
      // El inmueble de este chat esta alquilado/finalizado: el chat se cierra.
      function inmuebleCerrado(chatId) {
        return chatListingId(chatId).size() > 0
          && exists(/databases/$(database)/documents/propiedades/$(chatListingId(chatId)))
          && get(/databases/$(database)/documents/propiedades/$(chatListingId(chatId))).data.get('estado', '') == 'finalizado';
      }
      // El usuario es el DUENO del inmueble de este chat (el unico que propone).
      function esPropietario(chatId, uid) {
        return chatListingId(chatId).size() > 0
          && exists(/databases/$(database)/documents/propiedades/$(chatListingId(chatId)))
          && get(/databases/$(database)/documents/propiedades/$(chatListingId(chatId))).data.get('idPropietario', '') == uid;
      }
      // Tipo declarado, normalizando los mensajes antiguos (sin "tipo" = texto).
      function tipoMensaje() {
        return request.resource.data.get('tipo', 'texto');
      }
      // Una cita de visita es un mensaje bien formado: la pide el INTERESADO (no el
      // dueno), queda "pendiente" y no se puede agendar sobre un inmueble ya
      // alquilado (inmuebleCerrado, comprobado mas abajo).
      function citaValida() {
        return request.resource.data.solicitadoPor == request.auth.uid
          && !esPropietario(chat, request.auth.uid)
          && request.resource.data.get('citaId', '') == message
          && request.resource.data.fecha is string
          && request.resource.data.fecha.size() > 0
          && request.resource.data.fecha.size() <= 40
          && request.resource.data.hora is string
          && request.resource.data.hora.size() > 0
          && request.resource.data.hora.size() <= 10
          && request.resource.data.get('citaEstado', '') == 'pendiente';
      }
      // Solo el dueno del inmueble (o el otro participante si el chat no tiene
      // inmueble) puede confirmar o rechazar una cita ajena.
      function puedeResponderCita(uid) {
        return chatListingId(chat).size() == 0 || esPropietario(chat, uid);
      }
      // BLINDAJE (v14): un aviso "sistema" solo es legitimo si el chat esta de
      // verdad en un estado que lo justifica: cerrado (a mano o automaticamente a
      // las 48h) o con la visita ya resuelta. Antes cualquier mensaje de tipo
      // "sistema" entraba en cualquier chat, con lo que un atacante podía colar
      // avisos falsos de la plataforma ("verificacion pendiente", "no pagues
      // todavia") para pescar el celular de la victima. Estos son los tres unicos
      // avisos que la app escribe, y en los tres casos el estado del chat YA se
      // habia guardado antes de enviar el mensaje.
      function puedeAvisoSistema() {
        let c = get(/databases/$(database)/documents/chats/$(chat)).data;
        return c.get('estado', 'abierto') == 'cerrado'
          || c.get('cita', {}).get('estado', '') in ['aceptada', 'rechazada']
          || c.get('citaPendiente', {}).get('estado', '') == 'rechazada';
      }
      allow read: if request.auth != null && chatParticipa(chat, request.auth.uid);
      allow create: if request.auth != null
        && chatParticipa(chat, request.auth.uid)
        && !inmuebleCerrado(chat)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && tipoMensaje() in ['texto', 'propuesta', 'sistema', 'cita']
        // En un chat cerrado (manual o automatico a las 48h) ya no se escribe, pero
        // el aviso de cierre SI puede añadirse: por eso los mensajes de sistema se
        // permiten siempre y el resto no.
        && (!chatCerrado(chat) || tipoMensaje() == 'sistema')
        // ...y un "sistema" solo entra con un estado que lo justifique (v14).
        && (tipoMensaje() != 'sistema' || puedeAvisoSistema())
        // Solo el dueño del inmueble puede proponer un acuerdo de alquiler.
        && (tipoMensaje() != 'propuesta' || esPropietario(chat, request.auth.uid))
        // Las citas las agenda el interesado, nunca el dueño del inmueble.
        && (tipoMensaje() != 'cita' || citaValida());
      // Responder SOLO cambia el estado de la propuesta o de la cita, y nunca lo
      // hace el propio autor: ni un acuerdo ni una visita se auto-aprueban, y una
      // cita ya respondida no se puede volver a cambiar.
      allow update: if request.auth != null
        && chatParticipa(chat, request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['propuestaEstado', 'citaEstado', 'respondidoPor', 'respondidoAt',
                       'deliveredAt', 'readAt'])
        && (
          (resource.data.get('tipo', 'texto') == 'propuesta'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['propuestaEstado', 'respondidoPor', 'respondidoAt'])
            && request.resource.data.get('propuestaEstado', '') in ['aceptada', 'rechazada']
            && resource.data.propuestoPor != request.auth.uid)
          ||
          (resource.data.get('tipo', 'texto') == 'cita'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['citaEstado', 'respondidoPor', 'respondidoAt'])
            && request.resource.data.get('citaEstado', '') in ['aceptada', 'rechazada']
            && resource.data.get('citaEstado', '') == 'pendiente'
            && resource.data.solicitadoPor != request.auth.uid
            && puedeResponderCita(request.auth.uid))
          // RECIBOS (v15): el RECEPTOR (nunca el autor) puede poner los campos
          // "deliveredAt" y "readAt", y SOLO si no estaban puestos: asi salen los
          // checks de entregado/leido sin que nadie pueda fabricarse los suyos
          // ni borrar o pisar los del otro.
          // OJO: se valida cada campo SOLO si aparece en el diff, porque un
          // update de solo "readAt" (cuando "deliveredAt" ya estaba) es legitimo
          // y antes se rechazaba al exigir siempre deliveredAt.
          // OJO 2: NO se puede comprobar "request.resource.data.X is timestamp".
          // El cliente escribe FieldValue.serverTimestamp() y las reglas ven ese
          // valor como centinela, NO como timestamp, asi que esa comprobacion
          // daba false y rechazaba TODOS los recibos (PERMISSION_DENIED). La
          // proteccion real la da que cada campo solo se pueda anadir una vez.
          || (chatParticipa(chat, request.auth.uid)
            && resource.data.senderId != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['deliveredAt', 'readAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveredAt'])
                || !('deliveredAt' in resource.data))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['readAt'])
                || !('readAt' in resource.data)))
        );
      // Los mensajes NO se borran desde el cliente (historial para auditoria).
      allow delete: if false;
    }

    // DENUNCIAS (moderacion): lectura para autenticados; cada usuario crea/borra
    // SOLO sus propias denuncias (el backend con SA aplica el reportsCount).
    match /reports/{report} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.listingId is string
        && request.resource.data.motivo is string;
      allow update, delete: if request.auth != null
        && resource.data.reporterId == request.auth.uid;
    }

    // VERIFICACIONES por email: el doc usa como id el correo normalizado.
    // Cada usuario solo lee/crea la solicitud de SU PROPIO correo.
    match /verifications/{correo} {
      allow read: if request.auth != null && request.auth.email == correo;
      allow create: if request.auth != null
        && request.auth.email == request.resource.data.email
        && request.resource.data.email == correo;
      allow update, delete: if request.auth != null && request.auth.email == correo;
    }

    // VERIFICACION DE IDENTIDAD (documento): el doc usa como id el uid del usuario.
    // El usuario sube/lee/actualiza SOLO la suya; el panel admin (service account)
    // es quien cambia "estado" a aprobado/rechazado (el SA omite estas reglas).
    // Se exigen las 2 fotos: "imagen" (frente) e "imagenReverso" (adverso).
    match /verificaciones/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // El numero de documento se valida AQUI y no solo en la app: un DNI
      // peruano son exactamente 8 digitos. Sin esta regla, un cliente
      // modificado (o el propio script de alguien) podria mandar letras o 40
      // digitos al panel de admin.
      function documentoValido() {
        let n = request.resource.data.get('numeroDocumento', '');
        // (en reglas no hay "return" temprano: se encadena con &&, que es
        // cortocircuito, asi que n.size() solo se evalua si n es string).
        return n is string
          && n.size() > 0
          && n.size() <= 30
          && (request.resource.data.get('tipoDocumento', '') != 'DNI'
              || n.matches('^[0-9]{8}$'));
      }
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.imagen is string
        && request.resource.data.imagen.size() <= 900000
        && request.resource.data.imagenReverso is string
        && request.resource.data.imagenReverso.size() <= 900000
        && request.resource.data.get('estado', '') == 'pendiente'
        && documentoValido();
      // NO se reenvia en caliente: solo se puede reintentar si el admin RECHAZO
      // el expediente antes (mientras esta "pendiente" no hay segundo envio).
      allow update: if request.auth != null
        && request.auth.uid == uid
        && resource.data.uid == request.auth.uid
        && resource.data.get('estado', '') == 'rechazado'
        && request.resource.data.get('estado', '') == 'pendiente'
        && request.resource.data.imagen is string
        && request.resource.data.imagen.size() <= 900000
        && request.resource.data.imagenReverso is string
        && request.resource.data.imagenReverso.size() <= 900000
        && documentoValido();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // FAVORITOS: cada usuario lee/crea/borra SOLO los suyos.
    // Doc id = "<uid>__<propiedadId>"; el campo uid siempre es el del autor.
    match /favoritos/{favorito} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || favorito.matches('^' + request.auth.uid + '__'));
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.propiedadId is string
        && request.resource.data.propiedadId.size() > 0;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && favorito.matches('^' + request.auth.uid + '__');
    }

    // SOPORTE E INCIDENTES: el usuario crea SU ticket (usuarioId == uid).
    // Solo el autor lee/actualiza los suyos; el panel admin (service account)
    // omite estas reglas para listarlos y cambiar el estado.
    match /soporte/{ticket} {
      allow read: if request.auth != null
        && resource.data.usuarioId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.emailContacto is string
        && request.resource.data.asunto is string
        && request.resource.data.asunto.size() > 0
        && request.resource.data.asunto.size() <= 150
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() > 0
        && request.resource.data.mensaje.size() <= 4000
        && request.resource.data.estado == 'pendiente';
      // El usuario solo puede marcar SU ticket como resuelto (el admin cambia
      // el estado libremente con SA).
      allow update: if request.auth != null
        && resource.data.usuarioId == request.auth.uid
        && request.resource.data.estado == 'resuelto'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);
      allow delete: if request.auth != null
        && resource.data.usuarioId == request.auth.uid;
    }

    // Resto: sin acceso
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
